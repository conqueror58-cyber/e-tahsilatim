html <!DOCTYPE html> <html lang="tr"> <head> <meta charset="UTF-8"> <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"> <title>e-Tahsilatım | Yeni Nesil B2B Saha Tahsilat & Kasa</title> <!-- PWA Meta Etiketleri --> <link rel="manifest" href="manifest.json"> <meta name="mobile-web-app-capable" content="yes"> <meta name="apple-mobile-web-app-capable" content="yes"> <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"> <meta name="theme-color" content="#0f172a"> <!-- Google Fonts & Tailwind CDN & Lucide Icons --> <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet"> <script src="https://cdn.tailwindcss.com"></script> <script src="https://unpkg.com/lucide@latest"></script> <script> tailwind.config = { theme: { extend: { fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'], }, colors: { brand: { 50: '#f0fdf4', 100: '#dcfce7', 500: '#22c55e', 600: '#16a34a', 700: '#15803d', 800: '#065f46', 900: '#064e3b', }, surface: { dark: '#0f172a', card: '#1e293b', border: '#334155' } } } } } </script> <style> /* iOS Safe Area & No Select */ body { -webkit-touch-callout: none; -webkit-user-select: none; user-select: none; padding-top: env(safe-area-inset-top); padding-bottom: env(safe-area-inset-bottom); font-family: 'Plus Jakarta Sans', sans-serif; } input, textarea { -webkit-user-select: text; user-select: text; } /* Hide scrollbars */ ::-webkit-scrollbar { display: none; } * { -ms-overflow-style: none; scrollbar-width: none; } </style> </head> <body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased"> <!-- ================= AUTH / GİRİŞ EKRANI (Varsayılan Korumalı Giriş) ================= --> <div id="authScreen" class="fixed inset-0 z-50 bg-slate-950 flex flex-col justify-between p-6"> <div class="w-full max-w-md mx-auto my-auto space-y-6"> <div class="text-center space-y-2"> <div class="w-16 h-16 bg-emerald-600 rounded-2xl mx-auto flex items-center justify-center shadow-lg shadow-emerald-900/40"> <i data-lucide="wallet" class="w-8 h-8 text-white"></i> </div> <h1 class="text-2xl font-black tracking-tight text-white">e-Tahsilatım</h1> <p class="text-xs text-slate-400">Merkezi Kimlik Doğrulama & Rol Yetkilendirme</p> </div> <!-- Rol Seçim Sekmesi --> <div class="grid grid-cols-2 p-1 bg-slate-900 rounded-xl border border-slate-800"> <button id="roleAdminBtn" onclick="switchLoginRole('admin')" class="py-2.5 text-xs font-bold rounded-lg transition-all bg-emerald-600 text-white shadow-sm flex items-center justify-center gap-1.5"> <i data-lucide="shield-check" class="w-4 h-4"></i> Yönetici (Admin) </button> <button id="roleStaffBtn" onclick="switchLoginRole('staff')" class="py-2.5 text-xs font-semibold rounded-lg transition-all text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5"> <i data-lucide="user-check" class="w-4 h-4"></i> Saha Personeli </button> </div> <div class="bg-slate-900 border border-slate-800 p-5 rounded-2xl space-y-4 shadow-xl"> <div class="space-y-1.5"> <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Kullanıcı E-Posta</label> <div class="relative"> <i data-lucide="mail" class="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5"></i> <input id="loginEmail" type="email" value="conqueror58@gmail.com" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors"> </div> </div> <div class="space-y-1.5"> <label class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Şifre</label> <div class="relative"> <i data-lucide="lock" class="w-4 h-4 text-slate-500 absolute left-3.5 top-3.5"></i> <input id="loginPass" type="password" value="••••••••••••" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 pl-10 pr-4 text-sm text-white focus:outline-none focus:border-emerald-500 transition-colors"> </div> </div> <!-- 2FA SMS Kodu Alanı --> <div id="admin2faBox" class="space-y-1.5"> <div class="flex justify-between items-center text-[11px]"> <span class="font-bold text-slate-400 uppercase tracking-wider">SMS Doğrulama Kodu</span> <span class="text-emerald-400 font-medium">SMS Gönderildi</span> </div> <div class="grid grid-cols-6 gap-2"> <input type="text" maxlength="1" value="5" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> <input type="text" maxlength="1" value="8" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> <input type="text" maxlength="1" value="3" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> <input type="text" maxlength="1" value="9" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> <input type="text" maxlength="1" value="1" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> <input type="text" maxlength="1" value="4" class="text-center py-2 bg-slate-950 border border-slate-800 rounded-lg text-sm font-bold text-white"> </div> </div> <button onclick="handleLogin()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 active:scale-[0.99] text-white font-bold text-sm rounded-xl transition-all shadow-lg shadow-emerald-900/40 flex items-center justify-center gap-2"> <span>Güvenli Giriş Yap</span> <i data-lucide="arrow-right" class="w-4 h-4"></i> </button> </div> <div class="p-3 bg-slate-900/60 rounded-xl border border-slate-800/80 text-[11px] text-slate-400 space-y-1"> <p class="font-bold text-slate-300 flex items-center gap-1.5"> <i data-lucide="info" class="w-3.5 h-3.5 text-emerald-400"></i> Yetki & Güvenlik Matrisi: </p> <p><strong class="text-slate-200">conqueror58@gmail.com:</strong> Tam yetkili kasa, mizan, Z-raporu ve yönetim paneli.</p> <p><strong class="text-slate-200">Saha Personeli:</strong> Sadece tahsilat makbuzu düzenleme ve bakiye sorgulama.</p> </div> </div> </div> <!-- ================= TOP HEADER (ÜST BAR) ================= --> <header class="sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-slate-800/80 px-4 py-3 flex items-center justify-between"> <div class="flex items-center gap-2.5"> <div class="w-8 h-8 rounded-xl bg-emerald-600 flex items-center justify-center shadow-md shadow-emerald-900/30"> <i data-lucide="receipt" class="w-4 h-4 text-white"></i> </div> <div> <h1 class="text-sm font-bold tracking-tight text-white leading-tight">e-Tahsilatım</h1> <div class="flex items-center gap-1.5"> <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span> <span id="userBadge" class="text-[10px] text-slate-400 font-medium">Yönetici: conqueror58</span> </div> </div> </div> <div class="flex items-center gap-2"> <button onclick="openNotificationModal()" class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-slate-300 relative"> <i data-lucide="bell" class="w-4 h-4"></i> <span class="absolute top-1 right-1 w-2 h-2 bg-emerald-500 rounded-full"></span> </button> <button onclick="handleLogout()" title="Çıkış Yap" class="w-8 h-8 rounded-lg bg-slate-900 border border-slate-800 flex items-center justify-center text-rose-400"> <i data-lucide="log-out" class="w-4 h-4"></i> </button> </div> </header> <!-- ================= ANA İÇERİK KONTEYNERİ (SEKMELER) ================= --> <main class="flex-1 max-w-md w-full mx-auto p-4 pb-28"> <!-- 1. SEKME: KASA & GENEL ÖZET --> <section id="tabKasa" class="space-y-4"> <!-- Günlük Kasa Kartı --> <div class="bg-gradient-to-br from-slate-900 via-slate-900 to-slate-850 p-5 rounded-3xl border border-slate-800 shadow-2xl relative overflow-hidden"> <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl pointer-events-none"></div> <div class="flex justify-between items-start mb-2"> <span class="text-xs font-semibold text-slate-400">BUGÜNKÜ TAHSİLAT TOPLAMI</span> <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800/60">Canlı Kasa</span> </div> <div class="text-3xl font-black tracking-tight text-white mb-3"> ₺<span id="totalCashDisplay">48.750,00</span> </div> <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-800/80 text-xs"> <div> <span class="text-slate-400 block text-[10px]">Başarılı İşlem</span> <span class="font-bold text-slate-200">14 Tahsilat</span> </div> <div> <span class="text-slate-400 block text-[10px]">Kasa Denkliği</span> <span class="font-bold text-emerald-400">%100 Mutabık</span> </div> </div> </div> <!-- Hızlı İşlem Düğmeleri --> <div class="grid grid-cols-2 gap-3"> <button onclick="switchTab('tabMakbuz')" class="p-4 rounded-2xl bg-emerald-600 hover:bg-emerald-500 active:scale-[0.98] text-white flex flex-col items-center justify-center gap-2 shadow-lg shadow-emerald-950 font-bold text-sm transition-all"> <i data-lucide="plus-circle" class="w-6 h-6"></i> <span>Makbuz Kes</span> </button> <button onclick="switchTab('tabQR')" class="p-4 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 active:scale-[0.98] text-white flex flex-col items-center justify-center gap-2 font-bold text-sm transition-all"> <i data-lucide="qr-code" class="w-6 h-6 text-emerald-400"></i> <span>Hızlı QR Oku</span> </button> </div> <!-- Son Tahsilatlar Listesi --> <div class="space-y-2.5"> <div class="flex justify-between items-center text-xs font-bold text-slate-400"> <span>SON TAHSİLAT HAREKETLERİ</span> <button onclick="showToast('Tüm liste güncellendi')" class="text-emerald-400">Yenile</button> </div> <div id="receiptList" class="space-y-2"> <!-- Dinamik Liste Elemanı --> <div class="p-3.5 bg-slate-900 border border-slate-800/90 rounded-2xl flex items-center justify-between"> <div class="flex items-center gap-3"> <div class="w-10 h-10 rounded-xl bg-emerald-950 border border-emerald-800/50 flex items-center justify-center text-emerald-400 font-bold"> YT </div> <div> <h4 class="text-xs font-bold text-white">Yılmaz Ticaret Ltd. Şti.</h4> <p class="text-[10px] text-slate-400">VKN: 9481029381 • Havale/FAST</p> </div> </div> <div class="text-right"> <span class="text-xs font-extrabold text-emerald-400">+₺15.000,00</span> <span class="block text-[10px] text-slate-500">14:32</span> </div> </div> <div class="p-3.5 bg-slate-900 border border-slate-800/90 rounded-2xl flex items-center justify-between"> <div class="flex items-center gap-3"> <div class="w-10 h-10 rounded-xl bg-blue-950 border border-blue-800/50 flex items-center justify-center text-blue-400 font-bold"> ÖM </div> <div> <h4 class="text-xs font-bold text-white">Öztürk Mobilya Dekorasyon</h4> <p class="text-[10px] text-slate-400">TCKN: 29381048192 • Sanal POS</p> </div> </div> <div class="text-right"> <span class="text-xs font-extrabold text-emerald-400">+₺8.250,00</span> <span class="block text-[10px] text-slate-500">11:15</span> </div> </div> </div> </div> </section> <!-- 2. SEKME: MAKBUZ KES & KREDİ KARTI / SANAL POS MODÜLÜ --> <section id="tabMakbuz" class="space-y-4 hidden"> <!-- Başlık & Tür Seçici (Tahsilat / Tediye) --> <div class="grid grid-cols-2 p-1 bg-slate-900 rounded-xl border border-slate-800"> <button id="typeReceipt" onclick="setVoucherType('tahsilat')" class="py-2 text-xs font-bold rounded-lg bg-emerald-600 text-white flex items-center justify-center gap-1.5 transition-all"> <i data-lucide="arrow-down-left" class="w-4 h-4"></i> Tahsilat (Giriş) </button> <button id="typePayment" onclick="setVoucherType('tediye')" class="py-2 text-xs font-semibold rounded-lg text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5 transition-all"> <i data-lucide="arrow-up-right" class="w-4 h-4"></i> Tediye (Çıkış) </button> </div> <!-- Akıllı Cari Tamamlama (Autocomplete) --> <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3"> <div class="flex justify-between items-center"> <label class="text-xs font-bold text-slate-300 flex items-center gap-1.5"> <i data-lucide="building-2" class="w-4 h-4 text-emerald-400"></i> Cari Hesap Seçimi </label> <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-semibold">GİB Aktif Cari</span> </div> <div class="relative"> <i data-lucide="search" class="w-4 h-4 text-slate-500 absolute left-3 top-3.5"></i> <input id="cariSearchInput" oninput="handleCariSearch(this.value)" type="text" placeholder="Firma adı veya VKN/TCKN yazın..." class="w-full bg-slate-950 border border-slate-800 rounded-xl py-2.5 pl-9 pr-9 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition-colors"> <button id="clearSearchBtn" onclick="clearCariSelection()" class="hidden absolute right-3 top-3 text-slate-500 hover:text-slate-300"> <i data-lucide="x" class="w-4 h-4"></i> </button> <!-- Arama Sonuç Dropdown --> <div id="cariResultsDropdown" class="hidden absolute z-30 left-0 right-0 top-12 bg-slate-900 border border-slate-800 rounded-xl shadow-2xl max-h-48 overflow-y-auto divide-y divide-slate-800"> <!-- Otomatik Doldurulacak --> </div> </div> <!-- Seçili Cari Özeti Kartı --> <div id="selectedCariCard" class="p-3 bg-slate-950/80 rounded-xl border border-slate-800 text-xs space-y-1.5"> <div class="flex justify-between items-center"> <span class="font-bold text-white text-sm" id="cardCariTitle">Yılmaz Ticaret Ltd. Şti.</span> <span class="text-emerald-400 font-extrabold text-sm" id="cardCariBalance">₺42.500,00</span> </div> <div class="text-[11px] text-slate-400 flex justify-between"> <span>VKN: <strong class="text-slate-300" id="cardCariTax">9481029381</strong></span> <span>Yetkili: <strong class="text-slate-300" id="cardCariPerson">Ahmet Yılmaz</strong></span> </div> </div> </div> <!-- Tutar Girişi & Hızlı Tutar Butonları --> <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3"> <label class="text-xs font-bold text-slate-300 flex items-center justify-between"> <span>Tahsil Edilecek Tutar</span> <span class="text-[10px] text-slate-400">Para Birimi: TRY (₺)</span> </label> <div class="relative"> <span class="absolute left-4 top-3 text-xl font-bold text-emerald-400">₺</span> <input id="amountInput" type="number" value="15000" class="w-full bg-slate-950 border border-slate-800 rounded-xl py-3 pl-10 pr-4 text-xl font-black text-white focus:outline-none focus:border-emerald-500"> </div> <div class="grid grid-cols-4 gap-2 pt-1"> <button onclick="addAmount(1000)" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-[11px] font-bold text-slate-300">+₺1.000</button> <button onclick="addAmount(5000)" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-[11px] font-bold text-slate-300">+₺5.000</button> <button onclick="addAmount(10000)" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-[11px] font-bold text-slate-300">+₺10.000</button> <button onclick="setFullBalance()" class="py-1.5 bg-emerald-950 hover:bg-emerald-900 border border-emerald-800 rounded-lg text-[11px] font-bold text-emerald-300">Tüm Bakiye</button> </div> </div> <!-- Ödeme Yöntemi Seçimi --> <div class="space-y-2"> <label class="text-xs font-bold text-slate-400">ÖDEME ENSTRÜMANI</label> <div class="grid grid-cols-4 gap-2"> <button onclick="selectPaymentMethod('havale')" id="payBtnHavale" class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold flex flex-col items-center gap-1.5 text-slate-300 transition-all"> <i data-lucide="landmark" class="w-4 h-4 text-emerald-400"></i> Havale/EFT </button> <button onclick="selectPaymentMethod('kart')" id="payBtnKart" class="p-2.5 rounded-xl bg-emerald-600 text-white border border-emerald-500 text-xs font-bold flex flex-col items-center gap-1.5 shadow-md transition-all"> <i data-lucide="credit-card" class="w-4 h-4"></i> Kredi Kartı </button> <button onclick="selectPaymentMethod('nakit')" id="payBtnNakit" class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold flex flex-col items-center gap-1.5 text-slate-300 transition-all"> <i data-lucide="banknote" class="w-4 h-4 text-amber-400"></i> Nakit </button> <button onclick="selectPaymentMethod('cek')" id="payBtnCek" class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold flex flex-col items-center gap-1.5 text-slate-300 transition-all"> <i data-lucide="file-check" class="w-4 h-4 text-blue-400"></i> Çek/Senet </button> </div> </div> <!-- KREDİ KARTI / SANAL POS ALANI (Kredi Kartı Seçilince Açılır) --> <div id="creditCardModule" class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3.5"> <div class="flex items-center justify-between pb-2 border-b border-slate-800"> <div class="flex items-center gap-2"> <i data-lucide="shield-check" class="w-4 h-4 text-emerald-400"></i> <span class="text-xs font-bold text-white">Sanal POS & Kart Tahsilat</span> </div> <div class="flex gap-1.5"> <button onclick="setCardSubMethod('pos')" id="subPos" class="px-2 py-1 rounded bg-emerald-600 text-white text-[10px] font-bold">POS</button> <button onclick="setCardSubMethod('nfc')" id="subNfc" class="px-2 py-1 rounded bg-slate-800 text-slate-400 text-[10px] font-semibold">NFC</button> <button onclick="setCardSubMethod('link')" id="subLink" class="px-2 py-1 rounded bg-slate-800 text-slate-400 text-[10px] font-semibold">Link Gönder</button> </div> </div> <div id="cardFieldsManual" class="space-y-2.5 text-xs"> <div> <label class="text-[10px] text-slate-400 font-semibold uppercase">Kart Üzerindeki İsim</label> <input type="text" value="AHMET YILMAZ" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white"> </div> <div> <label class="text-[10px] text-slate-400 font-semibold uppercase">Kart Numarası</label> <div class="relative"> <input type="text" value="5400 •••• •••• 8421" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white tracking-widest font-mono"> <span class="absolute right-2.5 top-2 text-[10px] font-bold text-slate-400">Mastercard</span> </div> </div> <div class="grid grid-cols-2 gap-2"> <div> <label class="text-[10px] text-slate-400 font-semibold uppercase">SKT (AA/YY)</label> <input type="text" value="08/27" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white text-center"> </div> <div> <label class="text-[10px] text-slate-400 font-semibold uppercase">CVV</label> <input type="password" value="•••" class="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white text-center"> </div> </div> </div> <!-- Taksit Seçimi --> <div class="space-y-1.5 pt-1"> <label class="text-[10px] text-slate-400 font-semibold uppercase">Taksit Seçimi & POS Komisyonu</label> <div class="grid grid-cols-3 gap-2 text-center text-xs"> <div class="p-2 rounded-lg bg-emerald-950 border border-emerald-700 text-emerald-300 font-bold"> <span>Tek Çekim</span> <span class="block text-[10px] opacity-80">%1,89 Komisyon</span> </div> <div class="p-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-400 font-semibold"> <span>3 Taksit</span> <span class="block text-[10px] opacity-80">+%3,20</span> </div> <div class="p-2 rounded-lg bg-slate-950 border border-slate-800 text-slate-400 font-semibold"> <span>6 Taksit</span> <span class="block text-[10px] opacity-80">+%5,40</span> </div> </div> </div> <!-- Komisyon Özeti --> <div class="p-2.5 bg-slate-950 rounded-xl border border-slate-800 text-[11px] space-y-1"> <div class="flex justify-between text-slate-400"> <span>POS Komisyon Kesintisi:</span> <span class="text-rose-400 font-bold">-₺283,50</span> </div> <div class="flex justify-between text-slate-200 font-bold"> <span>Net Hesaba Geçecek:</span> <span class="text-emerald-400">₺14.716,50</span> </div> </div> </div> <!-- WhatsApp ve İletişim Seçeneği --> <div class="p-3 bg-slate-900 border border-slate-800 rounded-2xl flex items-center justify-between"> <div class="flex items-center gap-2.5"> <i data-lucide="message-square" class="w-5 h-5 text-emerald-400"></i> <div> <span class="text-xs font-bold text-white block">WhatsApp ile Makbuz İlet</span> <span class="text-[10px] text-slate-400">Onay anında müşteriye PDF gider</span> </div> </div> <input type="checkbox" checked class="w-4 h-4 accent-emerald-500 rounded"> </div> <!-- Makbuz Onay Butonu --> <button onclick="submitReceipt()" class="w-full py-3.5 bg-emerald-600 hover:bg-emerald-500 active:scale-[0.99] text-white font-extrabold text-sm rounded-2xl shadow-xl shadow-emerald-950 transition-all flex items-center justify-center gap-2"> <i data-lucide="check-circle-2" class="w-5 h-5"></i> <span>Makbuzu Onayla ve Kes (₺<span id="btnAmountDisplay">15.000,00</span>)</span> </button> </section> <!-- 3. SEKME: CARİLER & YENİ CARİ EKLEME --> <section id="tabCariler" class="space-y-4 hidden"> <div class="flex justify-between items-center"> <div> <h2 class="text-base font-bold text-white">Cari Hesap Portföyü</h2> <p class="text-[11px] text-slate-400">Müşteri ve Tedarikçi Listesi</p> </div> <button onclick="toggleNewCariModal(true)" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-md"> <i data-lucide="user-plus" class="w-4 h-4"></i> Cari Ekle </button> </div> <!-- Cari Filtre Butonları --> <div class="flex gap-2 overflow-x-auto pb-1 text-xs"> <button class="px-3 py-1.5 bg-emerald-950 border border-emerald-800 text-emerald-300 font-bold rounded-xl whitespace-nowrap">Tümü (48)</button> <button class="px-3 py-1.5 bg-slate-900 border border-slate-800 text-slate-400 font-semibold rounded-xl whitespace-nowrap">Borçlu Cariler (32)</button> <button class="px-3 py-1.5 bg-slate-900 border border-slate-800 text-slate-400 font-semibold rounded-xl whitespace-nowrap">Alacaklı Cariler (11)</button> </div> <!-- Cari Listesi --> <div id="cariPortfolioList" class="space-y-2.5"> <!-- Cari 1 --> <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-2xl space-y-2.5"> <div class="flex justify-between items-start"> <div> <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-semibold">Müşteri</span> <h3 class="text-xs font-extrabold text-white mt-1">Yılmaz Ticaret Ltd. Şti.</h3> <p class="text-[10px] text-slate-400">VKN: 9481029381 • Ahmet Yılmaz</p> </div> <div class="text-right"> <span class="text-[10px] text-slate-400 block">Cari Bakiye</span> <span class="text-xs font-black text-emerald-400">₺42.500,00</span> </div> </div> <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800 text-xs"> <button onclick="quickReceiptForCari('Yılmaz Ticaret Ltd. Şti.', 42500)" class="py-1.5 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800/80 rounded-lg text-emerald-300 font-bold flex items-center justify-center gap-1"> <i data-lucide="receipt" class="w-3.5 h-3.5"></i> Makbuz Kes </button> <button onclick="showToast('Ekstre PDF olarak hazırlandı')" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-slate-300 font-semibold flex items-center justify-center gap-1"> <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Ekstre </button> <button onclick="showToast('WhatsApp sohbeti açıldı')" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-emerald-400 font-semibold flex items-center justify-center gap-1"> <i data-lucide="send" class="w-3.5 h-3.5"></i> WP Mesaj </button> </div> </div> <!-- Cari 2 --> <div class="p-3.5 bg-slate-900 border border-slate-800 rounded-2xl space-y-2.5"> <div class="flex justify-between items-start"> <div> <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-950 text-emerald-400 border border-emerald-800 font-semibold">Müşteri</span> <h3 class="text-xs font-extrabold text-white mt-1">Öztürk Mobilya & Mimarlık</h3> <p class="text-[10px] text-slate-400">TCKN: 29381048192 • Selin Öztürk</p> </div> <div class="text-right"> <span class="text-[10px] text-slate-400 block">Cari Bakiye</span> <span class="text-xs font-black text-emerald-400">₺18.250,00</span> </div> </div> <div class="grid grid-cols-3 gap-2 pt-2 border-t border-slate-800 text-xs"> <button onclick="quickReceiptForCari('Öztürk Mobilya & Mimarlık', 18250)" class="py-1.5 bg-emerald-950/80 hover:bg-emerald-900 border border-emerald-800/80 rounded-lg text-emerald-300 font-bold flex items-center justify-center gap-1"> <i data-lucide="receipt" class="w-3.5 h-3.5"></i> Makbuz Kes </button> <button onclick="showToast('Ekstre PDF olarak hazırlandı')" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-slate-300 font-semibold flex items-center justify-center gap-1"> <i data-lucide="file-text" class="w-3.5 h-3.5"></i> Ekstre </button> <button onclick="showToast('WhatsApp sohbeti açıldı')" class="py-1.5 bg-slate-950 hover:bg-slate-800 border border-slate-800 rounded-lg text-emerald-400 font-semibold flex items-center justify-center gap-1"> <i data-lucide="send" class="w-3.5 h-3.5"></i> WP Mesaj </button> </div> </div> </div> </section> <!-- 4. SEKME: HIZLI QR TAHSİLAT & BANKA KAREKOD --> <section id="tabQR" class="space-y-4 hidden"> <div class="bg-slate-900 border border-slate-800 p-5 rounded-3xl text-center space-y-4"> <div class="w-12 h-12 rounded-2xl bg-emerald-950 border border-emerald-800 flex items-center justify-center mx-auto text-emerald-400"> <i data-lucide="scan" class="w-6 h-6"></i> </div> <div> <h2 class="text-base font-bold text-white">Banka QR ile Anında Tahsilat</h2> <p class="text-xs text-slate-400">Müşteri mobil bankacılığından okutsun, para anında şirket hesabına geçsin.</p> </div> <!-- Örnek QR Alanı --> <div class="p-4 bg-white rounded-2xl w-52 h-52 mx-auto flex items-center justify-center shadow-2xl"> <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=TR-KAREKOD:e-Tahsilatim:15000" alt="Banka Tahsilat QR" class="w-full h-full object-contain"> </div> <div class="text-xs font-semibold text-slate-300"> <span>Karekod Tutarı: <strong class="text-emerald-400 text-sm font-extrabold">₺15.000,00</strong></span> <span class="block text-[11px] text-slate-500 mt-0.5">Garanti BBVA • TR12 0006 2000 0001 2345 6789 01</span> </div> <button onclick="showToast('QR Kod WhatsApp ile Müşteriye Gönderildi')" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl shadow-lg transition-all flex items-center justify-center gap-2"> <i data-lucide="share-2" class="w-4 h-4"></i> Karekodu Paylaş </button> </div> </section> <!-- 5. SEKME: YÖNETİM & AYARLAR (ADMIN) --> <section id="tabAdmin" class="space-y-4 hidden"> <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl space-y-3"> <div class="flex items-center gap-3"> <div class="w-12 h-12 rounded-2xl bg-emerald-600 flex items-center justify-center font-bold text-white text-lg"> C </div> <div> <h3 class="text-sm font-bold text-white">conqueror58@gmail.com</h3> <span class="text-[10px] bg-emerald-950 text-emerald-400 border border-emerald-800 px-2 py-0.5 rounded-full font-bold">Yönetici / Patron</span> </div> </div> </div> <div class="space-y-2"> <label class="text-xs font-bold text-slate-400">YÖNETİM ARAÇLARI</label> <div class="bg-slate-900 border border-slate-800 rounded-2xl divide-y divide-slate-800 text-xs"> <button onclick="showToast('Gün Sonu Z-Raporu PDF oluşturuldu')" class="w-full p-3.5 flex items-center justify-between text-left hover:bg-slate-800/40 transition-colors"> <div class="flex items-center gap-2.5"> <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-400"></i> <span class="font-bold text-slate-200">Gün Sonu Z-Raporu Kapatma</span> </div> <i data-lucide="chevron-right" class="w-4 h-4 text-slate-500"></i> </button> <button onclick="showToast('Personel yetki konsolu açıldı')" class="w-full p-3.5 flex items-center justify-between text-left hover:bg-slate-800/40 transition-colors"> <div class="flex items-center gap-2.5"> <i data-lucide="users" class="w-4 h-4 text-blue-400"></i> <span class="font-bold text-slate-200">Ekip & Saha Plasiyer Yönetimi</span> </div> <i data-lucide="chevron-right" class="w-4 h-4 text-slate-500"></i> </button> <button onclick="showToast('POS Komisyon ve banka oranları açıldı')" class="w-full p-3.5 flex items-center justify-between text-left hover:bg-slate-800/40 transition-colors"> <div class="flex items-center gap-2.5"> <i data-lucide="percent" class="w-4 h-4 text-amber-400"></i> <span class="font-bold text-slate-200">Banka POS Oranları & Komisyon</span> </div> <i data-lucide="chevron-right" class="w-4 h-4 text-slate-500"></i> </button> </div> </div> </section> </main> <!-- ================= YENİ CARİ EKLEME POP-UP MODAL ================= --> <div id="newCariModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-end sm:items-center justify-center p-0 sm:p-4 hidden"> <div class="bg-slate-900 border border-slate-800 rounded-t-3xl sm:rounded-3xl max-w-md w-full p-5 space-y-4 shadow-2xl"> <div class="flex justify-between items-center pb-2 border-b border-slate-800"> <h3 class="text-sm font-bold text-white flex items-center gap-2"> <i data-lucide="user-plus" class="w-4 h-4 text-emerald-400"></i> Yeni Cari Kartı Oluştur </h3> <button onclick="toggleNewCariModal(false)" class="text-slate-400 hover:text-slate-200"> <i data-lucide="x" class="w-5 h-5"></i> </button> </div> <div class="space-y-3 text-xs"> <div> <label class="text-[11px] font-semibold text-slate-400 uppercase">Firma / Şahıs Resmi Ünvanı</label> <input id="newCariTitle" type="text" placeholder="Örn: Anadolu Makina San. Tic. Ltd." class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white mt-1"> </div> <div class="grid grid-cols-2 gap-2"> <div> <label class="text-[11px] font-semibold text-slate-400 uppercase">VKN / TCKN</label> <input id="newCariTax" type="text" placeholder="10 veya 11 hane" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white mt-1"> </div> <div> <label class="text-[11px] font-semibold text-slate-400 uppercase">Açılış Bakiyesi (₺)</label> <input id="newCariBal" type="number" placeholder="0.00" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white mt-1"> </div> </div> <div> <label class="text-[11px] font-semibold text-slate-400 uppercase">Yetkili Adı & WhatsApp Telefonu</label> <input id="newCariPhone" type="text" placeholder="0532 000 00 00" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-2.5 text-white mt-1"> </div> </div> <button onclick="saveNewCari()" class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 font-bold text-xs text-white rounded-xl shadow-lg transition-all"> Cariyi Kaydet ve Listeye Ekle </button> </div> </div> <!-- ================= BİLDİRİM TOAST ================= --> <div id="toastMessage" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 bg-emerald-600 text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-2xl transition-all duration-300 opacity-0 pointer-events-none"> İşlem Başarılı </div> <!-- ================= ALT SABİT TAB BAR (BOTTOM NAVIGATION) ================= --> <nav class="fixed bottom-0 left-0 right-0 z-40 bg-slate-950/95 backdrop-blur-lg border-t border-slate-800/80 px-4 py-2"> <div class="max-w-md mx-auto grid grid-cols-5 gap-1"> <button onclick="switchTab('tabKasa')" id="navKasa" class="flex flex-col items-center justify-center py-1 text-emerald-400 font-bold text-[10px] transition-colors"> <i data-lucide="layout-dashboard" class="w-5 h-5 mb-0.5"></i> <span>Kasa</span> </button> <button onclick="switchTab('tabMakbuz')" id="navMakbuz" class="flex flex-col items-center justify-center py-1 text-slate-400 hover:text-slate-200 font-semibold text-[10px] transition-colors"> <i data-lucide="receipt" class="w-5 h-5 mb-0.5"></i> <span>Makbuz</span> </button> <button onclick="switchTab('tabQR')" id="navQR" class="flex flex-col items-center justify-center py-1 -mt-4 text-white"> <div class="w-12 h-12 rounded-full bg-emerald-600 flex items-center justify-center shadow-lg shadow-emerald-950 border-4 border-slate-950"> <i data-lucide="qr-code" class="w-6 h-6"></i> </div> <span class="text-[9px] font-bold mt-0.5">QR</span> </button> <button onclick="switchTab('tabCariler')" id="navCariler" class="flex flex-col items-center justify-center py-1 text-slate-400 hover:text-slate-200 font-semibold text-[10px] transition-colors"> <i data-lucide="users" class="w-5 h-5 mb-0.5"></i> <span>Cariler</span> </button> <button onclick="switchTab('tabAdmin')" id="navAdmin" class="flex flex-col items-center justify-center py-1 text-slate-400 hover:text-slate-200 font-semibold text-[10px] transition-colors"> <i data-lucide="shield" class="w-5 h-5 mb-0.5"></i> <span>Yönetim</span> </button> </div> </nav> <!-- ================= JAVASCRIPT MOTORU & İŞ MANTIĞI ================= --> <script> // Lucide ikonlarını başlat lucide.createIcons(); // Veri Tabanı (Cari Portföyü) const CARILER = [ { id: 1, title: 'Yılmaz Ticaret Ltd. Şti.', tax: '9481029381', person: 'Ahmet Yılmaz', phone: '0532 450 11 22', balance: 42500 }, { id: 2, title: 'Öztürk Mobilya & Mimarlık', tax: '29381048192', person: 'Selin Öztürk', phone: '0544 123 45 67', balance: 18250 }, { id: 3, title: 'Kaya Lojistik & Antrepo', tax: '5549021873', person: 'Murat Kaya', phone: '0535 999 88 77', balance: 6400 }, { id: 4, title: 'Çelik Kardeşler Hırdavat', tax: '1234567890', person: 'Mehmet Çelik', phone: '0530 111 22 33', balance: 9150 } ]; let currentRole = 'admin'; // 'admin' | 'staff' // Giriş Rolü Değiştirme function switchLoginRole(role) { currentRole = role; const adminBtn = document.getElementById('roleAdminBtn'); const staffBtn = document.getElementById('roleStaffBtn'); const box2fa = document.getElementById('admin2faBox'); const emailInput = document.getElementById('loginEmail'); if (role === 'admin') { adminBtn.className = 'py-2.5 text-xs font-bold rounded-lg transition-all bg-emerald-600 text-white shadow-sm flex items-center justify-center gap-1.5'; staffBtn.className = 'py-2.5 text-xs font-semibold rounded-lg transition-all text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5'; box2fa.classList.remove('hidden'); emailInput.value = 'conqueror58@gmail.com'; } else { staffBtn.className = 'py-2.5 text-xs font-bold rounded-lg transition-all bg-emerald-600 text-white shadow-sm flex items-center justify-center gap-1.5'; adminBtn.className = 'py-2.5 text-xs font-semibold rounded-lg transition-all text-slate-400 hover:text-slate-200 flex items-center justify-center gap-1.5'; box2fa.classList.add('hidden'); emailInput.value = 'saha.personel@makbuz.com'; } } // Giriş Yap İşlemi function handleLogin() { const email = document.getElementById('loginEmail').value; document.getElementById('authScreen').classList.add('hidden'); const badge = document.getElementById('userBadge'); const navAdmin = document.getElementById('navAdmin'); if (email.includes('conqueror58')) { badge.innerText = 'Yönetici: conqueror58'; navAdmin.classList.remove('hidden'); showToast('Yönetici yetkileriyle giriş yapıldı'); } else { badge.innerText = 'Saha Personeli'; navAdmin.classList.add('hidden'); // Personele yönetim sekmesi gizlenir showToast('Saha personeli oturumu açıldı'); } } // Çıkış Yap function handleLogout() { document.getElementById('authScreen').classList.remove('hidden'); } // Sekmeler Arası Geçiş function switchTab(tabId) { const tabs = ['tabKasa', 'tabMakbuz', 'tabCariler', 'tabQR', 'tabAdmin']; tabs.forEach(t => { const el = document.getElementById(t); if (el) el.classList.add('hidden'); }); document.getElementById(tabId).classList.remove('hidden'); // Buton renklerini güncelle const navButtons = { tabKasa: 'navKasa', tabMakbuz: 'navMakbuz', tabCariler: 'navCariler', tabAdmin: 'navAdmin' }; Object.entries(navButtons).forEach(([key, btnId]) => { const btn = document.getElementById(btnId); if (btn) { if (key === tabId) { btn.className = 'flex flex-col items-center justify-center py-1 text-emerald-400 font-bold text-[10px] transition-colors'; } else { btn.className = 'flex flex-col items-center justify-center py-1 text-slate-400 hover:text-slate-200 font-semibold text-[10px] transition-colors'; } } }); window.scrollTo(0, 0); } // Akıllı Cari Arama (Autocomplete) function handleCariSearch(query) { const dropdown = document.getElementById('cariResultsDropdown'); const clearBtn = document.getElementById('clearSearchBtn'); if (!query || query.trim().length === 0) { dropdown.classList.add('hidden'); clearBtn.classList.add('hidden'); return; } clearBtn.classList.remove('hidden'); const filtered = CARILER.filter(c => c.title.toLowerCase().includes(query.toLowerCase()) || c.tax.includes(query) ); if (filtered.length === 0) { dropdown.innerHTML = '<div class="p-3 text-[11px] text-slate-400 text-center">Kayıtlı cari bulunamadı.</div>'; } else { dropdown.innerHTML = filtered.map(c => ` <div onclick="selectCari(${c.id})" class="p-2.5 hover:bg-slate-800/80 cursor-pointer flex justify-between items-center transition-colors"> <div> <div class="text-xs font-bold text-white">${c.title}</div> <div class="text-[10px] text-slate-400">VKN: ${c.tax} • ${c.person}</div> </div> <div class="text-xs font-bold text-emerald-400">₺${c.balance.toLocaleString('tr-TR')}</div> </div> `).join(''); } dropdown.classList.remove('hidden'); } // Cari Seçme function selectCari(id) { const cari = CARILER.find(c => c.id === id); if (!cari) return; document.getElementById('cariSearchInput').value = cari.title; document.getElementById('cardCariTitle').innerText = cari.title; document.getElementById('cardCariTax').innerText = cari.tax; document.getElementById('cardCariPerson').innerText = cari.person; document.getElementById('cardCariBalance').innerText = '₺' + cari.balance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); document.getElementById('cariResultsDropdown').classList.add('hidden'); } function clearCariSelection() { document.getElementById('cariSearchInput').value = ''; document.getElementById('cariResultsDropdown').classList.add('hidden'); document.getElementById('clearSearchBtn').classList.add('hidden'); } // Cariler Sekmesinden Hızlı Makbuza Geçiş function quickReceiptForCari(title, balance) { switchTab('tabMakbuz'); document.getElementById('cariSearchInput').value = title; document.getElementById('cardCariTitle').innerText = title; document.getElementById('cardCariBalance').innerText = '₺' + balance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); document.getElementById('amountInput').value = balance; document.getElementById('btnAmountDisplay').innerText = balance.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); } // Tutar Güncellemeleri function addAmount(val) { const input = document.getElementById('amountInput'); let curr = parseFloat(input.value) || 0; curr += val; input.value = curr; document.getElementById('btnAmountDisplay').innerText = curr.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); } function setFullBalance() { const input = document.getElementById('amountInput'); input.value = 42500; document.getElementById('btnAmountDisplay').innerText = '42.500,00'; } document.getElementById('amountInput').addEventListener('input', function(e) { const val = parseFloat(e.target.value) || 0; document.getElementById('btnAmountDisplay').innerText = val.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); }); // Ödeme Yöntemi Seçimi function selectPaymentMethod(method) { const ccModule = document.getElementById('creditCardModule'); const buttons = ['payBtnHavale', 'payBtnKart', 'payBtnNakit', 'payBtnCek']; buttons.forEach(id => { document.getElementById(id).className = 'p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-semibold flex flex-col items-center gap-1.5 text-slate-300 transition-all'; }); if (method === 'kart') { document.getElementById('payBtnKart').className = 'p-2.5 rounded-xl bg-emerald-600 text-white border border-emerald-500 text-xs font-bold flex flex-col items-center gap-1.5 shadow-md transition-all'; ccModule.classList.remove('hidden'); } else { ccModule.classList.add('hidden'); if (method === 'havale') document.getElementById('payBtnHavale').className = 'p-2.5 rounded-xl bg-emerald-600 text-white border border-emerald-500 text-xs font-bold flex flex-col items-center gap-1.5 shadow-md transition-all'; if (method === 'nakit') document.getElementById('payBtnNakit').className = 'p-2.5 rounded-xl bg-emerald-600 text-white border border-emerald-500 text-xs font-bold flex flex-col items-center gap-1.5 shadow-md transition-all'; if (method === 'cek') document.getElementById('payBtnCek').className = 'p-2.5 rounded-xl bg-emerald-600 text-white border border-emerald-500 text-xs font-bold flex flex-col items-center gap-1.5 shadow-md transition-all'; } } function setCardSubMethod(type) { ['subPos', 'subNfc', 'subLink'].forEach(id => { document.getElementById(id).className = 'px-2 py-1 rounded bg-slate-800 text-slate-400 text-[10px] font-semibold'; }); if (type === 'pos') document.getElementById('subPos').className = 'px-2 py-1 rounded bg-emerald-600 text-white text-[10px] font-bold'; if (type === 'nfc') { document.getElementById('subNfc').className = 'px-2 py-1 rounded bg-emerald-600 text-white text-[10px] font-bold'; showToast('Telefonun arkasına kartı yaklaştırın (NFC Aktif)'); } if (type === 'link') { document.getElementById('subLink').className = 'px-2 py-1 rounded bg-emerald-600 text-white text-[10px] font-bold'; showToast('Müşteriye SMS/WP Ödeme Linki Hazırlandı'); } } // Makbuz Gönder & Onayla function submitReceipt() { const amt = parseFloat(document.getElementById('amountInput').value) || 0; showToast(`₺${amt.toLocaleString('tr-TR')} Makbuz Onaylandı & Müşteriye Gönderildi!`); // Kasayı güncelle const cashDisplay = document.getElementById('totalCashDisplay'); let currTotal = 48750.00; currTotal += amt; cashDisplay.innerText = currTotal.toLocaleString('tr-TR', { minimumFractionDigits: 2 }); setTimeout(() => { switchTab('tabKasa'); }, 1000); } // Yeni Cari Ekleme Modal function toggleNewCariModal(show) { document.getElementById('newCariModal').classList.toggle('hidden', !show); } function saveNewCari() { const title = document.getElementById('newCariTitle').value; const tax = document.getElementById('newCariTax').value; const bal = parseFloat(document.getElementById('newCariBal').value) || 0; const phone = document.getElementById('newCariPhone').value; if (!title) { alert('Lütfen firma ünvanı girin'); return; } CARILER.unshift({ id: Date.now(), title, tax: tax || '1111111111', person: 'Yetkili', phone: phone || '-', balance: bal }); toggleNewCariModal(false); showToast('Yeni cari başarıyla kaydedildi!'); } // Toast Bildirim function showToast(msg) { const toast = document.getElementById('toastMessage'); toast.innerText = msg; toast.classList.remove('opacity-0', 'pointer-events-none'); setTimeout(() => { toast.classList.add('opacity-0', 'pointer-events-none'); }, 2500); } </script> </body> </html>
